PORT=5001
CACHE_DIR=.cache/pdf-tools
PDFTOOLS_CACHE_BYTES=2147483648
PDFTOOLS_MAX_SOURCE_BYTES=536870912
PDFTOOLS_MAX_PIXELS=20000000
PDFTOOLS_NATIVE_DPI=300
# Required before exposing private collection reads beyond local development:
PDFTOOLS_TOKEN=
PDFTOOLS_CORS_ORIGINS=*
# Comma-separated host/bucket allowlists:
PDFTOOLS_SOURCE_HOSTS=
PDFTOOLS_S3_BUCKETS=
# S3_ENDPOINT=https://s3.example.org
# Set credentials via the standard AWS environment/profile chain; never commit them.
